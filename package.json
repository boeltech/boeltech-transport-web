{
  "name": "boeltech-transport-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:design-tokens": "eslint src/features --config eslint.design-tokens.config.js --max-warnings 0",
    "audit:contrast": "tsx scripts/audit-contrast.ts --theme=dark",
    "audit:contrast:light": "tsx scripts/audit-contrast.ts --theme=light",
    "audit:copy-encoding": "tsx scripts/audit-copy-encoding.ts",
    "audit:sheet-modal": "tsx scripts/audit-sheet-modal.ts",
    "test:smoke:dark": "vitest run --project flows dark.smoke",
    "preview": "vite preview",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:serial": "vitest run --pool=forks --maxWorkers=1 --no-file-parallelism",
    "test:node": "vitest run --project node",
    "test:dom": "vitest run --project dom",
    "test:flows": "vitest run --project flows",
    "test:watch": "vitest",
    "test:trips:regression": "vitest run src/features/trips/presentation/pages/create/contract-trip-validation.test.ts src/features/trips/presentation/pages/create/validateTripApiPayload.test.ts src/features/trips/presentation/pages/create/components/validation.test.ts",
    "test:smoke:approvals": "vitest run --project flows approvals- trip-expense-",
    "test:smoke:approval-policies": "vitest run --project flows approval-policies-workflow",
    "test:smoke:notifications": "vitest run --project flows notifications-inbox",
    "test:smoke:fiscal-edit": "vitest run --project flows fiscal-edit-workflow",
    "test:smoke:address-picker": "vitest run --project flows address-picker-",
    "test:smoke:profitability-scope": "vitest run --project flows profitability-scope",
    "test:smoke:platform": "vitest run --project flows platform-admin-workflow platform-ar-workflow session-platform-erp-isolation",
    "test:smoke:platform-tenant-activate": "vitest run --project flows platform-tenant-activate",
    "test:smoke:billing": "vitest run --project flows billing-workflow",
    "test:smoke:billing-ar": "vitest run --project flows billing-ar.smoke",
    "test:smoke:billing-stripe": "vitest run --project flows billing-stripe",
    "test:smoke:catalogs-tenant": "vitest run --project flows catalogs-tenant-workflow",
    "test:smoke:platform-catalogs-import": "vitest run --project flows platform-catalogs-import",
    "test:smoke:credit": "vitest run --project flows credit-exposure-workflow",
    "test:smoke:branches": "vitest run --project flows branches-workflow",
    "test:smoke:branch-kpis": "vitest run --project dom src/features/dashboard/presentation/components/DashboardBranchKpisWidget.test.tsx src/features/branches/presentation/components/BranchOperationalKpiCard.test.tsx",
    "test:smoke:trip-multi-invoice": "vitest run --project flows trip-multi-invoice",
    "test:smoke:trip-false-trip": "vitest run --project flows trip-false-trip",
    "test:smoke:trip-trailers": "vitest run --project flows trip-trailers",
    "test:smoke:trip-canvas": "vitest run --project flows trip-canvas",
    "test:smoke:auth-phase2": "vitest run --project flows auth-phase2 session-platform-erp-isolation",
    "test:smoke:imports": "vitest run --project flows imports-workflow",
    "test:smoke:trip-revenue-split": "vitest run --project flows trip-revenue-split",
    "test:smoke:billing-dispatch": "vitest run --project flows billing-dispatch-workflow",
    "test:smoke:finance-dispatch-workbench": "vitest run --project flows finance-dispatch-workbench",
    "test:smoke:invoice-auto-dispatch": "vitest run --project flows invoice-auto-dispatch",
    "test:smoke:settlements": "vitest run --project flows settlements-workflow",
    "test:smoke:compensation-templates": "vitest run --project flows compensation-templates",
    "test:smoke:location-field": "vitest run --project flows location-field",
    "test:smoke:trip-sin-cfdi": "vitest run --project flows trip-sin-cfdi",
    "test:smoke:drivers": "vitest run --project flows drivers-workflow"
  },
  "dependencies": {
    "@boeltech/cfdi-domain": "0.41.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
