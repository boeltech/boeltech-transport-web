    "@tanstack/react-query": "^5.90.16",
    "@tanstack/react-query-devtools": "^5.91.2",
    "axios": "^1.13.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "html-entities": "^2.5.2",
    "lucide-react": "^0.562.0",
    "mapbox-gl": "^3.24.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
