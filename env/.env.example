# Template — copiar a env/.env.local para desarrollo
# Vite carga desde env/ (ver envDir en vite.config.ts). Solo documenta VITE_* de runtime
# y secretos de build Sentry (no se exponen al browser).

# --- API ---
VITE_API_URL=http://localhost:3000/api/v1
VITE_API_TIMEOUT=30000

# --- Geo / Mapbox ---
# mapbox | stub — default mapbox
VITE_GEO_PROVIDER=mapbox
VITE_MAPBOX_PUBLIC_TOKEN=

# --- App ---
VITE_APP_NAME=laTuno
VITE_APP_VERSION=1.0.0

# --- Dev ergonomics (ADR-0052) ---
# Reduce HTTP polling de React Query en desarrollo
# VITE_DISABLE_DEV_POLLING=true
# Reintentos de requests idempotentes (solo si === "true")
# VITE_ENABLE_RETRY=true

# --- Sentry (runtime: solo builds production con DSN) ---
# VITE_SENTRY_DSN=
# VITE_ENVIRONMENT=development
# VITE_GIT_SHA=local
# VITE_SENTRY_TRACES_SAMPLE_RATE=0
# Upload de sourcemaps en build (CI; NO prefijo VITE_ — no van al bundle):
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# --- Ayuda (menú usuario) ---
# Destinatario del mailto «Contactar soporte» (default: soporte@boeltech.com)
# VITE_SUPPORT_EMAIL=soporte@boeltech.com
# URL externa de guías; si está vacía no se muestra el botón en el Dialog Ayuda
# VITE_HELP_DOCS_URL=

# --- Turnstile (AUTH-HARDEN) ---
# Opcional en local (sin key no renderiza widget); en prod alinear con TURNSTILE_SECRET_KEY de la API
# VITE_TURNSTILE_SITE_KEY=

# --- AUTH-HARDEN Phase 2 (ADR-0070) — cableado en runtime ---
# Espejo UX del kill-switch API (enforcement real = PUBLIC_SELF_SERVE_REGISTER en API).
# API: si omitido, cerrado en production / abierto en no-prod. Abrir embudo prod: PUBLIC_SELF_SERVE_REGISTER=true.
# VITE_PUBLIC_SELF_SERVE_REGISTER=true
# bearer | dual | cookies — default web: cookies. Alinear con AUTH_SESSION_MODE de la API
# (default API: cookies). En local, usar el mismo modo en ambos repos. dual solo transición.
# VITE_AUTH_SESSION_MODE=cookies
# Cookies tenant: erp_at / erp_rt httpOnly (no leer desde JS); axios withCredentials
# MFA: enroll/confirm en /settings/security; challenge en login — sin vars VITE extra
