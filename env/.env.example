# Template
# Copiar a .env.local para desarrollo

# API Configuration
VITE_API_URL=http://localhost:3000/api/v1
VITE_API_TIMEOUT=30000
VITE_GEO_PROVIDER=mapbox
VITE_MAPBOX_PUBLIC_TOKEN=

# App Configuration
VITE_APP_NAME=Boeltech ERP
VITE_APP_VERSION=1.0.0

# Dev ergonomics (ADR-0052) — reduce HTTP polling while developing
# VITE_DISABLE_DEV_POLLING=true

# Network diagnostics (optional) — retries idempotent API requests in local/debug sessions
# VITE_ENABLE_RETRY=false

# --- Sentry (solo builds production con DSN; opcional en local) ---
# VITE_SENTRY_DSN=
# VITE_ENVIRONMENT=development
# VITE_GIT_SHA=local
# VITE_SENTRY_TRACES_SAMPLE_RATE=0
