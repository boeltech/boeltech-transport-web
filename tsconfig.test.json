{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "incremental": true,
    "noEmit": true,
    // Matchers de jest-dom: los aporta `import "@testing-library/jest-dom/vitest"` en src/test/setup.dom.ts.
    "types": ["vite/client", "vitest/globals"]
  },
  "include": [
    "src/**/*.d.ts",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/test/**/*"
  ],
  // Baseline F5.1w: tests con errores de tipos previos (65 archivos / 119 errores al crear este gate).
  // Esta lista SOLO puede achicarse: al corregir un archivo, quítalo de aquí. No agregar entradas;
  // un test nuevo o tocado debe tipar limpio. Prohibido as any / @ts-ignore / @ts-nocheck para salir.
